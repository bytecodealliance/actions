{
  "name": "github-actions",
  "version": "1.0.0",
  "description": "This provide actions for wasmtime setup",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build -o dist/wasmtime/setup src/wasmtime.ts && ncc build -o dist/wasm-tools/setup src/wasm-tools.ts && ncc build -o dist/wit-bindgen/setup src/wit-bindgen.ts",
    "test": "jest",
    "all": "npm run build && npm run format && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytecodealliance/github-actions.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "wasmtime"
  ],
  "author": "Rajat Jindal<rajatjindal83@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1",
    "@actions/github": "6.0.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "3.0.1",
    "@octokit/openapi-types": "^19.0.0",
    "@octokit/rest": "20.0.2",
    "@octokit/types": "^12.0.0",
    "@types/fs-extra": "^11.0.1",
    "fs-extra": "^11.1.0",
    "toml": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.11.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vercel/ncc": "^0.36.1",
    "eslint": "^7.32.0",
    "eslint-plugin-github": "4.3.2",
    "eslint-plugin-jest": "^25.3.2",
    "jest": "^27.2.5",
    "prettier": "2.8.4",
    "ts-jest": "^27.1.2",
    "typescript": "4.9.5",
    "@types/jest": "27.5.2"
  },
  "overrides": {
    "uuid@8": "11.1.1",
    "uuid@3": "11.1.1",
    "@octokit/plugin-paginate-rest@2": "9.2.2",
    "@octokit/request@5": "8.4.1",
    "@octokit/request-error@2": "5.1.1",
    "@octokit/plugin-paginate-rest@6": "9.2.2",
    "@octokit/request@6": "8.4.1",
    "@octokit/request-error@3": "5.1.1",
    "semver@6": "6.3.1",
    "toml@3": "5.0.1",
    "uuid@9": "11.1.1",
    "@babel/core@7": "7.29.7",
    "@babel/helpers@7": "7.29.10",
    "@babel/traverse@7": "7.29.10",
    "@tootallnate/once@1": "2.0.1",
    "ajv@6": "6.15.0",
    "ajv@8": "8.20.0",
    "brace-expansion@1": "1.1.21",
    "braces@3": "3.0.3",
    "browserslist@4": "4.29.5",
    "cross-spawn@7": "7.0.6",
    "debug@4": "4.4.3",
    "flatted@3": "3.4.4",
    "form-data@3": "3.0.5",
    "js-yaml@3": "3.15.2",
    "lodash@4": "4.18.1",
    "micromatch@4": "4.0.8",
    "minimatch@3": "3.1.5",
    "picomatch@2": "2.3.2",
    "semver@7": "7.8.5",
    "tough-cookie@4": "4.1.4",
    "word-wrap@1": "1.2.5",
    "ws@7": "7.5.13",
    "undici@5": "6.29.1",
    "@fastify/busboy@2": "3.2.4"
  }
}
